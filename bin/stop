#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from policy.hook import append
if len(sys.argv) != 2:
    raise SystemExit("Usage: bin/stop RUN_ID")
append("logs/stops.jsonl", dict(run_id=sys.argv[1], event="requested"))
print("Stop requested for " + sys.argv[1])
