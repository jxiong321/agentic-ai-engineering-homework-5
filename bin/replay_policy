#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import argparse
import json
from policy.hook import classify
COVERS = ["post_comment/human_active", "post_comment/human_quiet", "open_pr/develop"]
p = argparse.ArgumentParser()
p.add_argument("file")
p.add_argument("--json", action="store_true")
p.add_argument("--batched", action="store_true")
a = p.parse_args()
out = {c: {} for c in ("independent", "requires_approval", "prohibited")}
covered_runs = set()
separate = 0
for line in Path(a.file).read_text().splitlines():
    call = json.loads(line)
    klass, column = classify(call["action"], call["facts"])
    out[column][klass] = out[column].get(klass, 0) + 1
    if column == "requires_approval":
        if klass in COVERS:
            covered_runs.add(call["run_id"])
        else:
            separate += 1
prompts = len(covered_runs) + separate if a.batched else sum(out["requires_approval"].values())
out.update(prompts_per_day=prompts, seconds_per_prompt=600 / prompts if prompts else None)
if a.batched:
    out["covers"] = COVERS
print(json.dumps(out))
