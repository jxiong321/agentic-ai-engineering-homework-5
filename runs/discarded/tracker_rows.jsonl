{"table": "prs", "id": 12, "run_id": "planned-4307-s01-e6b3b7", "issue": 4307, "branch": "repomind/issue-4307", "title": "Read application version from package.json instead of npm_package_version", "body": "File: src/api/health.ts\n\nRead the version from package.json (or an imported module/constant) rather than process.env.npm_package_version, which is only set when running via npm run / npm start and evaluates to \"dev\" when starting via node directly in production containers.", "draft": 1, "state": "open", "key": "674c5479bc43cbba8316dbf4", "opened_at": "2026-11-05T23:35:02", "base": "develop", "closed_at": null, "merged_at": null}
