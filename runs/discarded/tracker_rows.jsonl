{"table": "prs", "id": 9, "run_id": "planned-4304-s01-f7a6df", "issue": 4304, "branch": "repomind/issue-4304", "title": "Handle storage removal errors individually in failed upload purge", "body": "File: src/ingest/worker.ts\n\nWrap the storage.remove call in purgeExpiredFailedUploads in a try/catch block so that an AccessDenied or missing object on a single failed upload does not halt the entire purge loop and block subsequent expired uploads from being processed.", "draft": 1, "state": "open", "key": "e8f417ca54c97dca5d8e5413", "opened_at": "2026-11-05T23:28:47", "base": "develop", "closed_at": null, "merged_at": null}
